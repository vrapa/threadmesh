{block title}E-maily{/block}
{block content}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Přehled e-mailů</h1>
        <p class="text-body-secondary mb-0">Důležité zprávy a doporučené další kroky na jednom místě.</p>
    </div>
    <span class="badge text-bg-dark rounded-pill px-3 py-2">{$emails|length} zpráv</span>
</div>

<form method="get" action="{link Dashboard:default}" class="card border-0 shadow-sm mb-4">
    <div class="card-body row g-3 align-items-end">
        <div class="col-6 col-lg-2">
            <label class="form-label" for="days">Období</label>
            <select class="form-select" id="days" name="days">
                <option value="1" selected={$days === 1}>24 hodin</option>
                <option value="7" selected={$days === 7}>7 dní</option>
                <option value="14" selected={$days === 14}>14 dní</option>
                <option value="30" selected={$days === 30}>30 dní</option>
            </select>
        </div>
        <div class="col-6 col-lg-3">
            <label class="form-label" for="importance">Důležitost</label>
            <select class="form-select" id="importance" name="importance">
                <option value="">Všechny priority</option>
                <option value="critical" selected={$importance === 'critical'}>Kritická</option>
                <option value="high" selected={$importance === 'high'}>Vysoká</option>
                <option value="normal" selected={$importance === 'normal'}>Běžná</option>
                <option value="low" selected={$importance === 'low'}>Nízká</option>
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label" for="assessed">Hodnocení</label>
            <select class="form-select" id="assessed" name="assessed">
                <option value="">Všechny</option>
                <option value="true" selected={$assessed === 'true'}>Vyhodnocené</option>
                <option value="false" selected={$assessed === 'false'}>Nevyhodnocené</option>
            </select>
        </div>
        <div class="col-6 col-lg-3">
            <label class="form-label" for="requiresAction">Vyžaduje akci</label>
            <select class="form-select" id="requiresAction" name="requiresAction">
                <option value="">Všechny</option>
                <option value="true" selected={$requiresAction === 'true'}>Ano</option>
                <option value="false" selected={$requiresAction === 'false'}>Ne</option>
            </select>
        </div>
        <div class="col-12 col-lg-2 d-grid"><button class="btn btn-dark">Filtrovat</button></div>
    </div>
</form>

{if $error}
    <div class="alert alert-danger" role="alert">{$error}</div>
{elseif !$emails}
    <div class="card border-0 shadow-sm"><div class="card-body text-center py-5">
        <h2 class="h5">Žádné zprávy</h2>
        <p class="text-body-secondary mb-0">Pro vybrané filtry nebyly nalezeny žádné e-maily.</p>
    </div></div>
{else}
    <div class="vstack gap-3">
    {foreach $emails as $email}
        <a n:href="Dashboard:detail id: $email['id']" class="mail-card card border-0 border-start border-{$email['importance_class']} shadow-sm text-decoration-none text-body">
            <div class="card-body p-3 p-lg-4">
                <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                    <div class="mail-meta text-body-secondary">
                        <strong class="text-body">{$email['author']['displayName'] ?? $email['author']['address'] ?? 'Neznámý odesílatel'}</strong>
                        {ifset $email['author']['address']}<span class="ms-1">&lt;{$email['author']['address']}&gt;</span>{/ifset}
                        <div class="mt-1">
                            <span class="fw-semibold">Komu:</span>
                            {if $email['recipients'] ?? []}
                                {foreach $email['recipients'] as $recipient}{sep}, {/sep}{$recipient['address'] ?? $recipient['displayName'] ?? 'Neznámý adresát'}{/foreach}
                            {else}
                                Neuvedeno
                            {/if}
                        </div>
                    </div>
                    <time class="mail-meta text-body-secondary">{$email['source_created_at']|date:'j. n. Y H:i'}</time>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge text-bg-{$email['importance_class']}">{$email['importance_label']}</span>
                    {if $email['requires_action']}<span class="badge text-bg-dark">Vyžaduje akci</span>{/if}
                    {if $email['category']}<span class="badge bg-body-secondary text-body">{$email['category']}</span>{/if}
                </div>
                <h2 class="h5 mb-2">{$email['title'] ?: '(bez předmětu)'}</h2>
                {if $email['summary']}<p class="summary text-body-secondary mb-0">{$email['summary']}</p>{/if}
            </div>
        </a>
    {/foreach}
    </div>
{/if}
{/block}

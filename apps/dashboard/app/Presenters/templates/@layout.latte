<!doctype html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>{ifset title}{include title|stripHtml} · {/ifset}ThreadMesh</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <style>
        :root { --tm-bg: #f3f6fb; --tm-ink: #172033; }
        body { background: var(--tm-bg); color: var(--tm-ink); }
        .navbar-brand { letter-spacing: -.03em; }
        .mail-card { border-left-width: .35rem !important; transition: transform .12s ease, box-shadow .12s ease; }
        .mail-card:hover { transform: translateY(-1px); box-shadow: 0 .5rem 1.25rem rgba(23, 32, 51, .08) !important; }
        .mail-card.border-warning { border-left-color: #fd7e14 !important; }
        .mail-meta { font-size: .875rem; }
        .summary { max-width: 68rem; }
        .message-frame { min-height: 32rem; background: white; }
    </style>
</head>
<body>
<nav class="navbar bg-dark navbar-dark shadow-sm">
    <div class="container py-1">
        <a class="navbar-brand fw-semibold" n:href="Dashboard:default">ThreadMesh <span class="fw-light opacity-75">Mail</span></a>
        <span class="navbar-text small">Lokální přehled schránky</span>
    </div>
</nav>
<main class="container py-4 py-lg-5">
    {include content}
</main>
</body>
</html>

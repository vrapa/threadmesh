{
  "name": "threadmesh/threadmesh",
  "description": "Self-hosted, API-first mail intelligence toolkit with IMAP, SQLite, and MCP.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Radovan Kraus",
      "role": "Creator and maintainer"
    }
  ],
  "keywords": [
    "automation",
    "connector",
    "email",
    "imap",
    "integration",
    "jira",
    "mcp",
    "sqlite",
    "workflow"
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-sodium": "*",
    "php-mcp/server": "^3.3",
    "symfony/http-foundation": "^7.0",
    "webklex/php-imap": "^6.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "ThreadMesh\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ThreadMesh\\Imap\\Tests\\": "tests/Imap/",
      "ThreadMesh\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/threadmesh",
    "bin/threadmesh-mcp"
  ],
  "scripts": {
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "test": "phpunit",
    "check": [
      "@test",
      "@analyse"
    ]
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

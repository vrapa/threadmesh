{
  "name": "threadmesh/core",
  "description": "Framework-agnostic contracts and domain model for connecting messages, tasks, and developer workflows.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Radovan Kraus",
      "role": "Creator and maintainer"
    }
  ],
  "keywords": [
    "automation",
    "connector",
    "email",
    "integration",
    "jira",
    "workflow"
  ],
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "ThreadMesh\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ThreadMesh\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress",
    "test": "phpunit",
    "check": [
      "@test",
      "@analyse"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
